# Raw firewall exports contain live secrets (password hashes, CARP/HA-sync
# passwords, private keys). Never commit an export to the engine repo.
*.xml
!tests/fixtures/*.xml

# Credentials / local env
.env
*.vault
vault-pass*

# Python
.venv/
__pycache__/
*.pyc


# OS
.DS_Store
*.egg-info/

# Exports (raw or sanitized) carry site addressing and MACs: they belong in the
# private site repo, never in the engine repo.
exports/
